<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep obsidian matte background -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF161C26" android:offset="0.0" />
                <item android:color="#FF0D111A" android:offset="0.5" />
                <item android:color="#FF06080D" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Warm amber radial flare from traffic signal light -->
    <path
        android:pathData="M54,54m-46,0a46,46 0,1 1,92 0a46,46 0,1 1,-92 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="46"
                android:type="radial">
                <item android:color="#33FFB300" android:offset="0.0" />
                <item android:color="#1A00E5FF" android:offset="0.65" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle technical reticle ring -->
    <path
        android:strokeWidth="0.8"
        android:pathData="M54,54m-38,0a38,38 0,1 1,76 0a38,38 0,1 1,-76 0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="16"
                android:startY="16"
                android:endX="92"
                android:endY="92"
                android:type="linear">
                <item android:color="#3300E5FF" android:offset="0.0" />
                <item android:color="#15FFFFFF" android:offset="0.5" />
                <item android:color="#33FFB300" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
